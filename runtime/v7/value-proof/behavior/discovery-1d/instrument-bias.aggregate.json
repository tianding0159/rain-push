      "type": "review_question"
    },
    {
      "biasType": "performance_collapse",
      "proposal": "add perform_confidence lexical cues (boast/flex markers) to the annotator.",
      "remediationBenefit": 0.373,
      "type": "guide_rule"
    },
    {
      "biasType": "trigger_fallback_bias",
      "proposal": "add a decision rule that prefers the nearest specific trigger domain before falling back to other/indeterminate.",
      "remediationBenefit": 0.312,
      "type": "guide_rule"
    },
    {
      "biasType": "driving_force_suppression",
      "proposal": "lower the evidence bar for emitting a driving-force CANDIDATE (candidate, not committed) so motive coverage matches the reference.",
